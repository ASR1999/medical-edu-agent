# ========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ========================================
# Logs & Temporary Files
# ========================================
*.log
logs/
*.log.*
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*.orig

# ========================================
# Environment & Configuration
# ========================================
.env
.env.local
.env.*.local
*.env
!ENV_EXAMPLE
!.env.example

# ========================================
# ML Models & Large Files
# ========================================
# Model files (too large for git)
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.tflite
*.h5
*.pb

# Model directories (keep structure, ignore contents)
models/
*.model/
checkpoints/
weights/

# Keep ct2_models directory structure but ignore large files
backend/ct2_models/**/*.bin
backend/ct2_models/**/*.pt
backend/ct2_models/**/*.pth

# ========================================
# Generated Files & Directories
# ========================================
# Audio files
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac

# Generated audio directories
backend/app/api/generated_audio/
backend/app/api/temp_uploads/
backend/app/api/uploads/

# RAG index
backend/app/data/rag_index/
backend/app/data/chroma_db/
*.index
*.faiss

# Temporary uploads
uploads/
temp_uploads/
generated_audio/

# ========================================
# Docker
# ========================================
# Keep docker-compose.yml and Dockerfiles, but ignore build artifacts
.dockerignore

# ========================================
# Database
# ========================================
*.db
*.sqlite
*.sqlite3
*.db-journal

# ========================================
# Testing
# ========================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/
test-results/
coverage/
*.cover
.hypothesis/
.pytest_cache/
.nox/

# ========================================
# Documentation Build
# ========================================
docs/_build/
docs/.doctrees/
site/

# ========================================
# Project-Specific
# ========================================
# Explicitly include docs directory and everything inside it
!docs/
!docs/**
# Un-ignore files that were matched by other rules
!/docs/info1.txt
!/docs/o2.txt
!/docs/*_backup.md
*.backup
*.old

# ML Training outputs
ml-training/**/checkpoints/
ml-training/**/logs/
ml-training/**/outputs/
ml-training/**/runs/
ml-training/**/wandb/
ml-training/**/__pycache__/
ml-training/**/*.pyc

# Report generation outputs
report_creation/output/
report_creation/temp/
report_creation/*.docx
!report_creation/MTP_template_IITJ.docx

# ========================================
# CI/CD
# ========================================
.github/workflows/*.log
.gitlab-ci.yml.local

# ========================================
# Miscellaneous
# ========================================
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Cache directories
.cache/
*.cache

# Lock files (optional - some teams prefer to commit these)
# package-lock.json
# yarn.lock
# poetry.lock


